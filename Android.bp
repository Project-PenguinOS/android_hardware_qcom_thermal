rust_defaults {
    name: "android.hardware.thermal-service.qti-defaults",
    vendor: true,
    prefer_rlib: true,
    srcs: ["main.rs"],
    rustlibs: [
        "android.hardware.thermal-V2-rust",
        "libbinder_rs",
        "liblibc",
        "liblog_rust",
        "liblogger",
        "libserde_json",
    ],
}

rust_binary {
    name: "android.hardware.thermal-service.qti",
    defaults: ["android.hardware.thermal-service.qti-defaults"],
    relative_install_path: "hw",
    init_rc: ["android.hardware.thermal-service.qti.rc"],
    vintf_fragments: ["android.hardware.thermal-service.qti.xml"],
}

rust_test {
    name: "android.hardware.thermal-service.qti-test",
    defaults: ["android.hardware.thermal-service.qti-defaults"],
    test_suites: ["general-tests"],
}
